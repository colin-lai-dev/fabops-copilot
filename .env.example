# Copy to .env and fill in. Never commit .env.

# Host port for the Compose Postgres. If you change it, change DATABASE_URL to match.
FABOPS_DB_PORT=5432
DATABASE_URL=postgresql://fabops:fabops@localhost:5432/fabops

# LLM (see ADR-0008). Default is local Ollama; paid providers only on explicit request.
LLM_PROVIDER=ollama            # ollama | anthropic | openai | gemini
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_REASONING_EFFORT=none     # qwen3 on Ollama: disables thinking; leave empty for other providers

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Retrieval models (bge-m3 dense+sparse, bge-reranker); cpu or cuda
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu

# Cache and usage logs
FABOPS_CACHE_DIR=.cache/llm
FABOPS_USAGE_LOG=.cache/usage.jsonl
FABOPS_DEBUG_TRACE=0

# Agent tools (ADR-0001). Shared secret for the short-lived identity JWT (>= 32 random chars),
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
FABOPS_JWT_SECRET=
FABOPS_MCP_URL=http://127.0.0.1:8765/mcp

# Langfuse (free cloud plan; acceptable only because all data is synthetic). Only masked trace
# fields are sent (ADR-0007). Set FABOPS_LANGFUSE=1 to turn the export on.
FABOPS_LANGFUSE=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
